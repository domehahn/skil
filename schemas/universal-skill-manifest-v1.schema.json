{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/domehahn/skil/schemas/universal-skill-manifest-v1.schema.json",
  "title": "Universal agent skill authoring manifest v1",
  "type": "object",
  "required": ["name", "version", "description", "entrypoint", "owners"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "compatible_with": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
