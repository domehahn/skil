{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/domehahn/skil/schemas/dependency-reputation-v1.schema.json",
  "title": "skil trusted dependency reputation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "packages"],
  "properties": {
    "version": {"const": 1},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ecosystem", "name", "abandoned"],
        "properties": {
          "ecosystem": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "abandoned": {"type": "boolean"},
          "last_update": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
