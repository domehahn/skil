{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/domehahn/skil/schemas/attestation-v1.schema.json",
  "title": "skil Attestation v1",
  "type": "object",
  "required": ["version", "subject", "producer", "analysis", "result", "timestamp", "evidence"],
  "properties": {
    "version": {"const": 1},
    "subject": {"type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "analysis": {"type": "array", "items": {"type": "string"}},
    "result": {"type": "object", "additionalProperties": false, "required": ["status", "maximum_severity", "risk_score"], "properties": {
      "status": {"enum": ["PASS", "WARN", "FAIL"]},
      "verdict": {"enum": ["CLEAR", "REVIEW", "BLOCK"]},
      "maximum_severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
      "risk_score": {"type": "integer", "minimum": 0, "maximum": 100}
    }},
    "timestamp": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "reference_closure": {"$ref": "#/$defs/referenceClosure"},
    "assurance_closure": {"type": "object"},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependencyIdentity"}},
    "signature": {
      "type": "object",
      "required": ["provider", "algorithm", "key_id", "value"],
      "properties": {
        "provider": {"const": "builtin.ed25519"},
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "referenceClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "nodes", "complete", "verified"],
      "properties": {
        "root_digest": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "nodes": {"type": "integer", "minimum": 1},
        "required_nodes": {"type": "integer", "minimum": 0},
        "unresolved_nodes": {"type": "integer", "minimum": 0},
        "blocking_findings": {"type": "integer", "minimum": 0},
        "max_depth": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"},
        "verified": {"type": "boolean"},
        "state": {"enum": ["SAFE", "UNSAFE", "UNKNOWN"]}
      }
    },
    "dependencyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "package", "source_kind", "source_url", "manifest_digest", "evidence"],
      "properties": {
        "ecosystem": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "source_kind": {"type": "string", "minLength": 1},
        "source_url": {"type": "string"},
        "artifact_digest": {"type": "string"},
        "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence": {"type": "object"}
      }
    }
  },
  "additionalProperties": false
}
