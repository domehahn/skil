{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/domehahn/skil/benchmark/schema/fixture-v1.schema.json",
  "title": "skil vendor-neutral benchmark fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tier", "title", "ground_truth", "references", "rationale", "artifact", "review"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^bench-[0-9]{3}-[a-z0-9-]+$" },
    "tier": {
      "enum": ["development", "evaluation"],
      "description": "development = public, may be used to diagnose and fix scanner bugs, never counted toward a headline metric. evaluation = the blind holdout; a fixture that has ever been used to fix a scanner bug must never move from development to evaluation (see benchmark/README.md)."
    },
    "title": { "type": "string", "minLength": 1 },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["malicious", "category"],
      "properties": {
        "malicious": { "type": "boolean" },
        "category": { "type": "string", "minLength": 1 }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "control"],
        "properties": {
          "framework": {
            "enum": [
              "owasp-agentic-skills-top-10",
              "owasp-agentic-applications-2026",
              "mitre-atlas",
              "advisory"
            ]
          },
          "control": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewers"],
      "properties": {
        "status": { "enum": ["provisional", "gold"] },
        "reviewers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "if": { "properties": { "status": { "const": "gold" } } },
      "then": { "properties": { "reviewers": { "minItems": 2 } } }
    }
  }
}
